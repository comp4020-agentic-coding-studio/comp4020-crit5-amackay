---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// BASE_URL is the configured base verbatim, and astro.config.ts writes it with
// no trailing slash --- joining naively yields ".../comp4020-crit5-amackaycard.png".
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

// og:image wants an absolute URL: a relative one resolves against whichever
// page names it, and scrapers vary in how they do that.
const card = new URL(`${base}card.png`, Astro.site);
const favicon = `${base}favicon.png`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />

    <link rel="icon" type="image/png" href={favicon} />

    <!--
      The link-preview card and the tab icon are both screenshots of the game's
      own stylesheet, re-taken by `pnpm images`. No og:title/og:description:
      scrapers fall back to the <title> and description above --- but
      og:image:alt has nothing to fall back to, and the card carries no text at
      all, so without it a preview read aloud is the description and then
      silence where the picture was.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content={card} />
    <meta
      property="og:image:alt"
      content="Five pale balls packed inside a square cardboard tray on a grey-green carpet, pressed tight against the walls and each other."
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
