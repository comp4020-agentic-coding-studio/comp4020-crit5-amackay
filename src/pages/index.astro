---
import Layout from "../layouts/Layout.astro";
import { histogramRows } from "../game/histogram";
import { newSession } from "../game/session";

// The opening screen, server-rendered: level one, one row in the nav, and the
// two empty slots the running game fills. So dist/index.html carries what a
// first-time player actually sees --- which is the state the "no instructions"
// spec line is about, and the state the static text checks measure.
// Everything with a pixel position (the box, the balls, the bar lengths) is
// written on hydrate; createChrome adopts these elements in place.
const rows = histogramRows(newSession());
---

<Layout
  title="Bounding Box"
  description="A puzzle about circle packing: balls in a square tray, and a box that closes as far as the arrangement inside it allows. Ten levels, one more ball each time, scored against the smallest square known to hold them."
>
  <nav aria-label="Levels" id="levels">
    {
      rows.map((row) => (
        <a
          class:list={["level", { "is-current": row.current }]}
          data-n={row.n}
          aria-label={`Level ${row.n}`}
          aria-current={row.current ? "step" : undefined}
          style={row.bestFraction != null ? `--bar: ${row.bestFraction}` : undefined}
        >
          <span class="bar" />
          <span class="notch" style={`--at: ${row.notches.three}`} />
          <span class="notch" style={`--at: ${row.notches.two}`} />
          <span class="notch" style={`--at: ${row.notches.one}`} />
        </a>
      ))
    }
  </nav>
  <main>
    <h1>Bounding Box</h1>
    <div id="stage"></div>
  </main>
  <button class="advance" type="button" aria-label="Next level" hidden></button>
  <div id="finish"></div>
  <script src="../scripts/main.ts"></script>
</Layout>
